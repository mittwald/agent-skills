# mittwald API Configuration
#
# Copy this file to your project directory, fill in your token, and source it:
#   cp example.env .env
#   source .env
#
# NEVER commit this file with real values!

# mittwald API token with api_write scope
# Obtain from: https://studio.mittwald.de/app/profile/api-tokens
MITTWALD_API_TOKEN=<your-api_write-token>

# Optional: Default project ID (if you're always working with the same project)
# Find in mStudio URL or via: mw project list
# MITTWALD_PROJECT_ID=<project-id>

# Optional: Default organization ID
# Find via: mw organization list
# MITTWALD_ORG_ID=<org-id>
